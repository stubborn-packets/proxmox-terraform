# Local Terraform directories
**/.terraform/

# State files
**/*.tfstate
**/*.tfstate.*
**/*.tfstate.backup

# Variable files that may contain secrets
**/*.tfvars
**/*.tfvars.json
!**/terraform.tfvars.example

# Plan files
*.tfplan
*.plan
**/tfplan*

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# OS / Editor
.DS_Store
*.swp
*~